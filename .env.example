# Copy to .env and replace the local placeholders.
# The migration role owns the schema. The application role is restricted.
DATABASE_URL=postgresql://eli_app:local-app-password@127.0.0.1:5432/eli
MIGRATION_DATABASE_URL=postgresql://eli_owner:local-owner-password@127.0.0.1:5432/eli
APP_ORIGIN=http://127.0.0.1:5173
PORT=3001
# For PostgreSQL and browser tests, use the separate eli_test database.
# TEST_DATABASE_URL=postgresql://eli_app:local-app-password@127.0.0.1:5432/eli_test
# TEST_MIGRATION_DATABASE_URL=postgresql://eli_owner:local-owner-password@127.0.0.1:5432/eli_test
# Optional local demo. Supply a password with at least 12 characters.
# DEMO_SLUG=lusaka-demo
# DEMO_EMAIL=admin@example.test
# DEMO_PASSWORD=
